{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/admin/dashboard",
      "dest": "/admin/dashboard.html"
    },
    {
      "src": "/booking",
      "dest": "/booking.html"
    },
    {
      "src": "/my-bookings",
      "dest": "/my-bookings.html"
    },
    {
      "src": "/therapist-portal",
      "dest": "/therapist-portal.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
